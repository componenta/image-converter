{
    "name": "componenta/image-converter",
    "description": "Image conversion helpers for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^4.0",
        "componenta/mimetype-detector": "^2.0",
        "ext-exif": "*",
        "ext-gd": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Image\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Image\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit tests"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Image\\ConfigProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
