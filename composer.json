{
    "name": "componenta/image-converter",
    "description": "Image conversion helpers for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^4.0",
        "componenta/mimetype-detector": "^2.0",
        "ext-exif": "*",
        "ext-gd": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "guzzlehttp/psr7": "^3.6",
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Image\\Converter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Image\\Converter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "bench": "@php vendor/bin/phpbench run --report=aggregate",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Image\\Converter\\ConfigProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
